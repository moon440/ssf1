on(release){
   if(_root.itemchance == 0.1)
   {
      _root.itemchance = 0;
   }
   else if(_root.itemchance == 0.15)
   {
      _root.itemchance = 0.1;
   }
   else if(_root.itemchance == 0.25)
   {
      _root.itemchance = 0.15;
   }
   else if(_root.itemchance == 0.35)
   {
      _root.itemchance = 0.25;
   }
   else if(_root.itemchance == 0.5)
   {
      _root.itemchance = 0.35;
   }
}
